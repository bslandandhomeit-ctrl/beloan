<?php
if(isset($show) && $show == true){
    $data = [];
    $total_amount = 0.00;
    $data_fee_charge = [];
    $total_amount_fee = 0.00;
    $date_expense = [];
    $total_amount_expense = 0.00;

    $monthly_income = array_fill(1,12,0.00);
    $monthly_expense = array_fill(1,12,0.00);
    if(!empty($incomes) && count($incomes) > 0){
        $label = config('static_data.loan_type');
        $interest_income = array_fill(1,count($label),0.00);
        foreach($incomes as $income){
            if(count($income->payment) > 0){
                $loan_type = $income->loan_type;
                if(!isset($interest_income[$loan_type])) $interest_income[$loan_type] = 0.00;
                foreach($income->payment as $p){
                    $mon_in[$loan_type][date('n',strtotime($p->repayment_date))] = $p->paid_interest;
                     $interest_income[$loan_type] += $p->paid_interest + $p->penalty_amount;
                     $m = date('n',strtotime($p->repayment_date));
                     $monthly_income[$m] += $p->paid_interest + $p->penalty_amount;
                }
            }
        }

        $total_amount = array_sum($interest_income);
        foreach($interest_income as $key => $inc){
            if($inc > 0){
               $data[] = [
                    'label'=> $label[$key],
                    'data'=> $inc
                ];
            }
        }
    }
    /* inter */
    $fee_income = [];
    $fee_income[0] = 0.0; /* Early Payment */
    if(!empty($payoff) && count($payoff) > 0){
        foreach($payoff as $p){
            $fee_income[0] += $p->payoff_fee;
            $m = date('n',strtotime($p->payoff_date));
            $monthly_income[$m] += $p->payoff_fee;
        }
    }
    if(!empty($feecharges) && count($feecharges) > 0){
        foreach($feecharges as $fc){
            $key = $fc->charge_type;
            if(!isset($fee_income[$key])) $fee_income[$key] = 0.00;
            $fee_income[$key] += $fc->charge_amount;
            $m = date('n',strtotime($fc->charge_date));
            $monthly_income[$m] += $fc->charge_amount;
        }

    }

    $total_amount_fee = array_sum($fee_income);
    $fee_charge = config('static_data.fee_charge');
    $fee_label = [0=>' Early Payment'];
    $fee_label = array_merge($fee_label,$fee_charge);
    foreach($fee_income as $key => $fin){
        if($fin > 0){
           $data_fee_charge[] = [
                'label' => $fee_label[$key],
                'data' => $fin
            ];
        }
    }

    /* expense */
    $expense_fee = [];
    $expense_fee[0] = 0.00; /* Write Off */
    if(!empty($writeoff) && count($writeoff) > 0){
        foreach($writeoff as $wf){
            $expense_fee[0] += $wf->amount;
            $m = date('n',strtotime($wf->write_off_date));
            $monthly_expense[$m] += $wf->amount;
        }
    }

    if(!empty($cost) && count($cost)){
        foreach($cost as $c){
            if(!isset($expense_fee[$c->cost_type])) $expense_fee[$c->cost_type] = 0.00;
            $expense_fee[$c->cost_type] += $c->cost_amount;
            $m = date('n',strtotime($c->cost_date));
            $monthly_expense[$m] += $c->cost_amount;
        }
    }

    $total_amount_expense = array_sum($expense_fee);
    $cost_type = config('static_data.fee_cost_type');
    $cost_label = [0=>' Write Off'];
    $cost_label = array_merge($cost_label,$cost_type);
    foreach($expense_fee as $key => $ex){
        if($ex > 0){
             $date_expense[] = [
                    'label' => $cost_label[$key],
                    'data' => $ex
              ];
        }
    }
}

?>
