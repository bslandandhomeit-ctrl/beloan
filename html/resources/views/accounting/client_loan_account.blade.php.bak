<script type="text/javascript">
$(document).ready(function () {
//pagination
$('.custom-pagi a').on('click', function () {
    val = $(this).parent().find('input[name="set_offset"]').val();
    $('input[name="offset"]').val(val);
    $('#search_frm').submit();
    return false;
});

});
</script>
