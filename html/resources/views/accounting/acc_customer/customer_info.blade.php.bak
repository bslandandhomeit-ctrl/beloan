                            <tr>
                                <td>Billed From</td>
                                <td>From Billed</td>
                                <td style="border:none"></td>
                                <td>Address</td>
                                <td>{{$journal_prop->address}}</td>
                            </tr>

                            </tbody>
                        </table>
