        <?php $cn = 0;?>
        <?php 
        		$darr = array();
            	foreach($loan_doc as $d){
	            	foreach($arr as $key=>$value){
	            		$ex = explode('__', $key);
	            		if($ex[1]==$d->doc_type){
	            			$darr[$ex[0]] = array(
	            					'doc_type'=>$arr[$ex[0].'__'.$d->doc_type],
	            					'doc_photo'=>$d->doc_photo,
	            					'note'=>$d->note,
	            					'loan_id'=>$d->loan_id
	            			);
	            		}
	            	}
            	}
            	ksort($darr);
        ?>
        
        @foreach($darr as $d)
            <?php 
        		$cn++;
        		$doc_type = $d['doc_type'];
        		$doc_photo = $d['doc_photo'];
        		$note = $d['note'];
        		$loan_id = $d['loan_id'];
        	?>
            <tr>
                <td align="center">{{ $cn }}</td>
                <td>{{ $doc_type }}</td>
                <td align="center">{{ !empty($note)? $note : '-' }}</td>
