@section('js')
     <script src="http://maps.googleapis.com/maps/api/js"></script>
    <script>
        var map;
        var marker;
        $('#map').on('shown.bs.modal', function () {
            google.maps.event.trigger(map, 'resize');
            map.panTo(marker.getPosition());
        });
        var lat = <?php echo $client->location_latitude?$client->location_latitude:11.5500;?>;
        var lon = <?php echo $client->location_longitude?$client->location_longitude:104.9167;?>;
        var myCenter = new google.maps.LatLng(parseFloat(lat), parseFloat(lon));
        function initialize(){
            var mapProp = {
                          center:myCenter,
                          zoom:15,
                          mapTypeId:google.maps.MapTypeId.ROADMAP
                        };
            map = new google.maps.Map(document.getElementById("googleMap"),mapProp);
            marker = new google.maps.Marker({
                          position:myCenter,
                          animation:google.maps.Animation.BOUNCE
                      });
            marker.setMap(map);
        }
        google.maps.event.addDomListener(window, 'load', initialize);
    </script>
@endsection