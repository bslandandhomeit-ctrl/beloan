<script type="text/javascript">
    $(document).ready(function(){
        $(".form_datetime-component").datepicker({
            format: "dd MM yyyy",
            autoclose: true
        });
    });
     $("#address_city").select2();
    $("#address_city").on('change',function(e){
        var city = $(this).val();
        $("#location").val(city + ", ");
    });
</script>
