 <script type="text/javascript">
 $(document).ready(function(){
	 $('.dpYears').datepicker({
         format: 'yyyy-mm-dd',
         autoclose: true,
         setDate: new Date()
     });
	 $('#selCate').select2();
     var k = 0;
     var disburse_on;
