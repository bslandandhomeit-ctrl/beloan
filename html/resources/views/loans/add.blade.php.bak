<?php
 function html_form( $ilabel,$irequired_flg,$iname,$iid){
         $str ='<label class="control-label col-sm-3">'.$ilabel;
         if($irequired_flg == true){
            $str .=  '<span class="red">*</span>';
         }

         $str .= '</label>
                    <div class="col-md-8">
                        <input type="text" name="'.$iname.'" id="'.$iid.'" class="form-control">
                    </div>';
         return $str;
     }
?>
