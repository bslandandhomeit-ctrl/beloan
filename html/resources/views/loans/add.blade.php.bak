 function save_draft(){
	//save draft loan
	 formdata = $('#addloanForm').serialize();

     $.ajax({
         url: '/loans/save_draft',
         type: 'GET',
         dataType: "json",
         processData: false,
         contentType: false,
         data: formdata+'&client_name='+$('#client-name').val()+'&sell_price='+$('#sell_price').val()+'&url=<?php echo url(Request::fullUrl())?>',
         success: function(data){
	            if(data.status=='false'){
					return false;
		        }
	     }
	});
 }
 </script>
