                        <tbody>
                            @forelse($drawdown_accounts as $das)
                            <tr>
                                <td><a href="{{ route('drawdown_account_detail', $das->id) }}">{{$das->account_name}}</a></td>
                                <td>{{$das->account_no}}</td>
                                <td>{{$das->company_branch->branch_name}}</td>
                            <?php  
				$old_entry_date = date("Y-m-d", strtotime($journals[$das->coa_id][0]->entry_date)); 
				$ent_date = $entry_date = null; $debit = $credit = 0; $desc = "";
                                if(count($journals[$das->coa_id])>0){
                                foreach($journals[$das->coa_id] as $jd){
                                  $entry_date = date("Y-m-d", strtotime($jd->entry_date));
                                  if(date_dif($old_entry_date, $entry_date, 1, false) != 0) continue;
                                  $ent_date = $entry_date;
                                  $debit += $jd->debit;
                                  $credit += $jd->credit;
                                  $desc = ($jd->decription != "")?$jd->decription : $jd->j_desc;
                                  $old_entry_date = $entry_date;
                                }
                                }
                                ?>
                                <td>{{$ent_date}}</td>
                                <td>{{$debit}}</td>
                                <td>{{$credit}}</td>
				<td>{{$currency[$das->currency].number_format($das->balance, 2)}}</td>
                                <td>{{$desc}}</td>
		                <td>{{$drawdown_status[$das->status]}}</td>
                            </tr>
                            <?php $n++;?>
                            @empty
                            <tr><td colspan=12>{{ trans('multiple.m_no_result')}}</td></tr>
                            @endforelse
                        </tbody>
