<?php

    $graph_principal_collection = array_fill(1,12,0.00);
    $graph_interest_collection = array_fill(1,12,0.00);
    $graph_penalty_collection = array_fill(1,12,0.00);
    if(!empty($loan_payment) && count($loan_payment) > 0){
        $label = config('static_data.loan_type');
        $interest_income = array_fill(1,count($label),0.00);
        foreach($loan_payment as $income){
            if(count($income->payment) > 0){
                $loan_type = $income->loan_type;
                if(!isset($interest_income[$loan_type])) $interest_income[$loan_type] = 0.00;
                foreach($income->payment as $p){
                    $m = date('n',strtotime($p->repayment_date));
                    $graph_principal_collection[$m] += $p->paid_principal;
                    $graph_interest_collection[$m] += $p->paid_interest;
                    $graph_penalty_collection[$m] += $p->penalty_amount;
                }
            }
        }
    }
    /* inter */
    $fee_income = [];
    $fee_income[0] = 0.0; /* Early Payment */
    if(!empty($loan_payoff) && count($loan_payoff) > 0){
        foreach($loan_payoff as $p){
            $fee_income[0] += $p->payoff_fee;
            $m = date('n',strtotime($p->payoff_date));
            $graph_penalty_collection[$m] += $p->payoff_fee;
        }
    }
    if(!empty($loan_feecharge) && count($loan_feecharge) > 0){
        foreach($loan_feecharge as $fc){
            $key = $fc->charge_type;
            if(!isset($fee_income[$key])) $fee_income[$key] = 0.00;
            $fee_income[$key] += $fc->charge_amount;
            $m = date('n',strtotime($fc->charge_date));
            $graph_penalty_collection[$m] += $fc->charge_amount;
        }
    }
?>
