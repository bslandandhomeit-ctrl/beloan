            <?php
                $loan_type_label = config('static_data.loan_type');
                $fee_charge_label = config('static_data.fee_charge');
                $cost_fee_label = config('static_data.fee_cost_type');

                $interest_income = array_fill(1,count($loan_type_label),array_fill(1,12,0.0));
                $fee_commission_income = array_fill(0,count($fee_charge_label) + 2,array_fill(1,12,0.0));
                $interest_expense = array_fill(0,count($cost_fee_label)+1,array_fill(1,12,0.0));
                $month_arr = [1=>'Jan',2=>'Feb',3=>'Mar',4=>'Apr',5=>'May',6=>'Jun',7=>'Jul',8=>'Aug',9=>'Sep',10=>'Oct',11=>'Nov',12=>'Dec'];

                if(!empty($loan_payment) && count($loan_payment)>0){
                    foreach($loan_payment as $loan){
                        if(!empty($loan->payment) && count($loan->payment)>0){
                            $loan_type = $loan->loan_type;
                            foreach($loan->payment as $p){
                                $repayment_month = date('n', strtotime($p->repayment_date));
                                $interest_income[$loan_type][$repayment_month] += $p->paid_interest;
                                $fee_commission_income[0][$repayment_month] += $p->penalty_amount;
                            }
                        }
                    }
                }
                if(!empty($loan_payoff) && count($loan_payoff)>0){
                    foreach($loan_payoff as $loan){
                        if(!empty($loan->payoff)){
                            $payoff_month = date('n', strtotime($loan->payoff->payoff_date));
                            if(array_key_exists($payoff_month,$month_arr)){
                                  $fee_commission_income[1][$payoff_month] += $loan->payoff->payoff_fee;
                            }
                        }
                    }
                }
                if(!empty($loan_writeoff) && count($loan_writeoff)>0){
                    foreach($loan_writeoff as $loan){
                        if(!empty($loan->writeoff)){
                            $writeoff_month = date('n', strtotime($loan->writeoff->write_off_date));
                            if(array_key_exists($writeoff_month,$month_arr)){
                                $interest_expense[0][$writeoff_month] += $loan->writeoff->amount;
                            }
                        }
                    }
                }
                if(!empty($loan_feecharge) && count($loan_feecharge)>0){
                    foreach($loan_feecharge as $loan){
                        if(!empty($loan->feecharge) && count($loan->feecharge)>0){
                            foreach($loan->feecharge as $c){
                                $charge_month = date('n', strtotime($c->charge_date));
                                if(array_key_exists($charge_month,$month_arr)){
                                    $charge_type = $c->charge_type;
                                    $fee_commission_income[$charge_type+1][$charge_month] += $c->charge_amount;
                                }
                            }
                        }
                    }
                }

                if(!empty($loan_costfee) && count($loan_costfee)>0){
                    foreach($loan_costfee as $loan){
                        if(!empty($loan->costfee) && count($loan->costfee)>0){
                            foreach($loan->costfee as $fee){
                                 $cost_month = date('n', strtotime($fee->cost_date));
                                 if(array_key_exists($cost_month,$month_arr)){
                                    $cost_type = $fee->cost_type;
                                    $interest_expense[$cost_type][$cost_month] += $fee->cost_amount;
                                 }
                            }
                        }
                    }
                }
                $fee_charge_label = array_merge(['Penalty Charge','Early Payment'],$fee_charge_label);
                $cost_fee_label = array_merge(['Write-Off'],$cost_fee_label);
            ?>
